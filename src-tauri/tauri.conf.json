{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Light",
  "version": "0.3.6",
  "identifier": "com.ailight.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main", "title": "AI Light", "width": 1100, "height": 760,
      "minWidth": 900, "minHeight": 640, "center": true,
      "visible": false, "resizable": true, "backgroundColor": "#101316"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Local Codex status light · Rust desktop controller",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {"type":"downloadBootstrapper","silent":true},
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": ["SimpChinese", "English"],
        "startMenuFolder": "AI Light",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
